{
  "dash": {
    "command": "{python}",
    "args_template": ["{file}"],
    "cwd": "code",
    "check_package": null
  },
  "streamlit": {
    "command": "{python}",
    "args_template": ["-m", "streamlit", "run", "{file}"],
    "cwd": "code",
    "check_package": "streamlit",
    "fallbacks": []
  },
  "notebook": {
    "command": "{python}",
    "args_template": ["-m", "jupyter", "lab", "{file}"],
    "cwd": "code",
    "check_package": "jupyterlab",
    "fallbacks": [
      {
        "command": "{python}",
        "args_template": ["-m", "notebook", "{file}"],
        "cwd": "code",
        "check_package": "notebook"
      }
    ]
  },
  "script": {
    "command": "{python}",
    "args_template": ["{file}"],
    "cwd": "code",
    "check_package": null
  }
}
