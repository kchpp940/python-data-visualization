{
  "_comment": "Launch schema for python-data-visualization. Keys are example 'type' values used in examples_manifest.json. Each entry tells launcher.py HOW to launch an example of that type: what command to use, what arguments to pass, which cwd to run from, which Python package to check for availability, and optional fallbacks if the primary launcher is missing.",

  "dash": {
    "command": "{python}",
    "args_template": ["{file}"],
    "cwd": "code",
    "check_package": "dash",
    "launcher_packages": ["dash"],
    "fallbacks": []
  },

  "streamlit": {
    "command": "{python}",
    "args_template": ["-m", "streamlit", "run", "{file}"],
    "cwd": "code",
    "check_package": "streamlit",
    "launcher_packages": ["streamlit"],
    "fallbacks": []
  },

  "notebook": {
    "command": "{python}",
    "args_template": ["-m", "jupyter", "lab", "{file}"],
    "cwd": "code",
    "check_package": "jupyterlab",
    "launcher_packages": ["jupyterlab", "jupyter", "notebook"],
    "fallbacks": [
      {
        "args_template": ["-m", "notebook", "{file}"],
        "launcher_packages": ["notebook"]
      },
      {
        "args_template": ["-m", "jupyter", "notebook", "{file}"],
        "launcher_packages": ["jupyter"]
      }
    ]
  },

  "static": {
    "command": "{python}",
    "args_template": ["-m", "http.server", "8765"],
    "cwd": "code",
    "check_package": null,
    "launcher_packages": [],
    "browse_hint": "打开 http://localhost:8765/{file} 查看静态资源",
    "fallbacks": []
  }
}
